{
    "compilerOptions": {
        "target": "es2023",
        "module": "node16",
        "moduleResolution": "node16",
        "declaration": true,
        "emitDeclarationOnly": true,

        "outDir": "dist",
        "rootDir": "src",

        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
