{
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/.yarn": true,
        "**/esm": true,
        "**/node_modules": true,
        "**/yarn.lock": true
    },
    "files.associations": {
        "**/.github/workflows/*.yml": "github-actions-workflow"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    }
}
